{
  "name": "customer-service-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api:types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.0", "react-dom": "^19.2.0", "react-router-dom": "^7.9.5",
    "react-markdown": "^10.1.0", "remark-gfm": "^4.0.1", "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@types/node": "^24.10.0",
    "typescript": "~5.9.3", "vite": "^7.2.0", "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.17", "@tailwindcss/vite": "^4.1.17",
    "openapi-typescript": "^7.10.1", "vitest": "^3.2.4"
  }
}
